# Windows local development only
POSTGRES_USER=blog
POSTGRES_PASSWORD=blog_local_dev
POSTGRES_DB=blog
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://blog:blog_local_dev@127.0.0.1:55432/blog
# Optional direct connection for migrations when the hosted database uses a pooler.
# DATABASE_DIRECT_URL=
INTERNAL_API_URL=http://127.0.0.1:8000
PUBLIC_SITE_URL=http://127.0.0.1:5173
MEDIA_BACKEND=local
MEDIA_ROOT=.local/media
SESSION_TTL_SECONDS=86400
COOKIE_SECURE=false
SITE_TIMEZONE=Asia/Shanghai
